modules = ["nodejs-20", "web", "bash", "java-graalvm22.3"]
run = "npm run dev"

[nix]
channel = "stable-25_05"

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

[workflows]
runButton = "Deploy Web App"

[[workflows.workflow]]
name = "Run Dev Server"
author = 43564906
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "Build and Serve"
author = 46165312
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx serve out -p 5000"

[[workflows.workflow]]
name = "Deploy Web App"
author = 46165312
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"

[[workflows.workflow]]
name = "Build Android App"
author = 46180974
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "chmod +x build-android.sh"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./build-android.sh"

[[workflows.workflow]]
name = "Debug Android Build"
author = 46400926
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"🔍 Starting Android build debug process...\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Node version: $(node --version)\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"NPM version: $(npm --version)\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm list --depth=0 2>/dev/null || echo \"⚠️ Some packages may be missing\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Checking Next.js config...\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cat next.config.ts"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Running build with verbose output...\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build 2>&1 | tee build.log"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Build completed. Check build.log for details.\""
