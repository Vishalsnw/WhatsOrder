
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles and Subcollections (Forms & Seller Orders)
    match /users/{userId} {
      allow read: if true; // Public store catalog viewing
      allow write: if request.auth != null && request.auth.uid == userId;

      // Seller Forms under user doc
      match /forms/{formId} {
        allow read: if true;
        // Allow public customers to increment order count / deduct stock, and seller full management
        allow create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if true;
      }

      // Seller Orders inbox under user doc
      match /orders/{orderId} {
        // Customer (public) can place order into seller's inbox
        allow create: if true;
        // Seller can read, update status, or delete orders
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Catch-all subcollections default for user
      match /{subcollection=**} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 2. Shared Public Forms Collection
    match /publicForms/{formId} {
      allow read: if true;
      allow write: if true; // Customer order submit & stock update
    }

    // 3. Top-Level Orders Collection (Global Backup Recording)
    match /orders/{orderId} {
      allow create: if true; // Customer can submit order
      allow read, update, delete: if request.auth != null; // Sellers can view & manage orders
    }

    // 4. Auxiliary Collections (Products, Businesses, OrderForms)
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /forms/{formId} {
      allow read: if true;
      allow write: if true;
    }

    match /orderForms/{formId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
